##############################################################################
##                                                                          ##
##              GARAGE GUARDIAN — ENVIRONMENT CONFIGURATION                 ##
##                                                                          ##
##  HOW TO USE:                                                             ##
##    1. Copy this file:  cp .env.example .env                              ##
##    2. Edit the sections below — start with the ★ REQUIRED items          ##
##    3. Run:  make setup                                                    ##
##                                                                          ##
##  SECTIONS:                                                               ##
##    1.  Application Identity                                              ##
##    2.  Domain & URL                                                      ##
##    3.  Database (MariaDB)                                                ##
##    4.  Cache, Session & Queue (Redis)                                    ##
##    5.  Email / Notifications                                             ##
##    6.  WebSocket / Real-Time (Reverb)                                    ##
##    7.  File Storage (MinIO / S3)                                         ##
##    8.  OCR Service (Tesseract)                                           ##
##    9.  Authentication & Security                                         ##
##    10. Garage App Settings                                               ##
##    11. Logging & Monitoring                                              ##
##    12. Docker & Infrastructure Passwords                                 ##
##    13. Third-Party Integrations (optional)                               ##
##                                                                          ##
##############################################################################


##############################################################################
##  1. APPLICATION IDENTITY
##############################################################################

# The name shown in browser tabs, emails, and notification headers
APP_NAME="Garage Guardian"

# Environment: local | staging | production
# ★ REQUIRED — set to "production" on your server
APP_ENV=local

# Set to false in production (hides errors from users)
APP_DEBUG=false

# Laravel app key — auto-generated by: php artisan key:generate
# ★ REQUIRED — leave blank; setup script fills this in
APP_KEY=

# App timezone — affects timestamps, schedules, and cron jobs
# See: https://www.php.net/manual/en/timezones.php
# Examples: UTC | Asia/Dubai | Asia/Riyadh | Africa/Nairobi | Europe/London
APP_TIMEZONE=Asia/Dubai

# Default language (en | ar)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en


##############################################################################
##  2. DOMAIN & URL
##############################################################################

# ★ REQUIRED — Your server's public domain or IP
# Production example: https://techaura-projects.com
# Local dev example:  http://localhost
APP_URL=https://techaura-projects.com

# Frontend URL (usually same as APP_URL in production)
FRONTEND_URL=https://techaura-projects.com

# Domains allowed to send authenticated API cookies (Sanctum SPA)
# Add your domain AND localhost for dev. Comma-separated, no spaces, no http://
# Example: techaura-projects.com,localhost,localhost:5173
SANCTUM_STATEFUL_DOMAINS=techaura-projects.com,www.techaura-projects.com,localhost,localhost:5173

# Session cookie name (change if running multiple apps on same domain)
SESSION_COOKIE=garage_guardian_session


##############################################################################
##  3. DATABASE (MariaDB 10.11)
##############################################################################

DB_CONNECTION=mysql

# Host: use container name inside Docker, or IP for external DB
DB_HOST=mariadb
DB_PORT=3306

# ★ REQUIRED — Database name
DB_DATABASE=garage_guardian

# ★ REQUIRED — App DB user (not root)
DB_USERNAME=garage

# ★ REQUIRED — Strong password (min 16 chars recommended)
# Example: DB_PASSWORD=X9#mK2@pLqR7&vNz
DB_PASSWORD=change_me_garage_db_password

# ★ REQUIRED — MariaDB root password (used for backups and init)
DB_ROOT_PASSWORD=change_me_root_password

# Connection pool settings (adjust for your VPS RAM)
DB_POOL_MIN=2
DB_POOL_MAX=10


##############################################################################
##  4. CACHE, SESSION & QUEUE (Redis)
##############################################################################

# Cache backend: redis | database | file
CACHE_STORE=redis

# Queue backend: redis | database | sync (sync = no background jobs)
QUEUE_CONNECTION=redis

# Session storage: redis | database | cookie | file
SESSION_DRIVER=redis

# How long sessions stay alive (in minutes). 480 = 8 hours
SESSION_LIFETIME=480

# Encrypt session data at rest (recommended: true)
SESSION_ENCRYPT=true

# Redis connection
REDIS_HOST=redis
REDIS_PORT=6379
# Redis password — set one in docker/redis/redis.conf too
# Leave as null if no Redis auth (dev only)
REDIS_PASSWORD=null

# Separate Redis databases for different purposes
REDIS_DB=0          # Default / queues
REDIS_CACHE_DB=1    # Cache store
REDIS_SESSION_DB=2  # Sessions


##############################################################################
##  5. EMAIL / NOTIFICATIONS
##############################################################################
#
#  Used for:
#   - Job card status notifications
#   - Purchase order approval emails
#   - Parts request alerts
#   - Password reset links
#   - User account creation
#

# Mail driver: smtp | log | null | mailgun | ses
# Use "log" in dev to write emails to laravel.log instead of sending
MAIL_MAILER=smtp

# ─── SMTP Settings ───────────────────────────────────────────────────────────

# For dev (Docker Mailpit): MAIL_HOST=mailpit, MAIL_PORT=1025
# For production SMTP examples below:

# --- Gmail / Google Workspace ---
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=yourname@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_ENCRYPTION=tls

# --- Hostinger Email ---
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=587
# MAIL_USERNAME=noreply@techaura-projects.com
# MAIL_PASSWORD=your_hostinger_email_password
# MAIL_ENCRYPTION=tls

# --- Brevo (Sendinblue) ---
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=your_brevo_login_email
# MAIL_PASSWORD=your_brevo_smtp_key
# MAIL_ENCRYPTION=tls

# --- Mailtrap (staging testing) ---
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your_mailtrap_user
# MAIL_PASSWORD=your_mailtrap_password
# MAIL_ENCRYPTION=tls

# Active configuration (change to your preferred provider above):
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

# ─── Sender Identity ─────────────────────────────────────────────────────────

# ★ Email address that appears in "From:" on all system emails
MAIL_FROM_ADDRESS=noreply@techaura-projects.com

# ★ Name that appears in "From:" on all system emails
MAIL_FROM_NAME="Garage Guardian"

# ─── Notification Recipients ─────────────────────────────────────────────────

# Email to receive critical system alerts (failed jobs, security events)
NOTIFY_ADMIN_EMAIL=admin@techaura-projects.com

# Email to receive daily/weekly report summaries (leave blank to disable)
NOTIFY_REPORTS_EMAIL=reports@techaura-projects.com

# Email to notify when a Purchase Order is submitted for manager approval
NOTIFY_PO_MANAGER_EMAIL=manager@techaura-projects.com

# Email to notify when a Purchase Order needs finance approval
NOTIFY_PO_FINANCE_EMAIL=finance@techaura-projects.com


##############################################################################
##  6. WEBSOCKET / REAL-TIME (Laravel Reverb)
##############################################################################
#
#  Reverb is the self-hosted WebSocket server — NO Pusher account needed.
#  Powers: live job card updates, bay monitor, scan session pairing,
#          real-time notifications, central dashboard.
#

BROADCAST_CONNECTION=reverb

# ★ REQUIRED — Generate a random string for each of these (min 32 chars)
# Use: openssl rand -hex 32
REVERB_APP_ID=garage-guardian-prod
REVERB_APP_KEY=change_me_reverb_app_key_32_chars_min
REVERB_APP_SECRET=change_me_reverb_app_secret_32_chars_min

# Reverb server address (inside Docker network — do not change)
REVERB_HOST=reverb
REVERB_PORT=8080

# Scheme for the Reverb server connection
# Inside Docker: http — NGINX handles TLS termination externally
REVERB_SCHEME=http

# Frontend Vite env — mirrors the Reverb settings above
# These tell the React app where to connect for WebSockets
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# If your domain serves WebSockets at a public URL (for production):
# VITE_REVERB_HOST=techaura-projects.com
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https


##############################################################################
##  7. FILE STORAGE (MinIO — Self-hosted S3)
##############################################################################
#
#  MinIO is your self-hosted S3-compatible object store.
#  Stores: QC photos, scanned images, exported reports, avatars
#

FILESYSTEM_DISK=s3

# ★ REQUIRED — MinIO admin credentials (change from defaults!)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password_strong

# Laravel S3 driver settings (points to your MinIO container)
AWS_ACCESS_KEY_ID="${MINIO_ROOT_USER}"
AWS_SECRET_ACCESS_KEY="${MINIO_ROOT_PASSWORD}"
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=garage-guardian

# Internal endpoint (backend → MinIO inside Docker network)
AWS_ENDPOINT=http://minio:9000

# Public URL for generating presigned download links
# In production, this should be your domain + /storage OR MinIO's public port
AWS_URL=https://techaura-projects.com/storage
# AWS_URL=http://your-server-ip:9000/garage-guardian

# Required for MinIO path-style URLs (keep true)
AWS_USE_PATH_STYLE_ENDPOINT=true

# MinIO Console admin UI URL (port 9001 by default)
MINIO_CONSOLE_URL=http://localhost:9001


##############################################################################
##  8. OCR SERVICE (Self-hosted Tesseract)
##############################################################################
#
#  Self-hosted OCR for license plate recognition.
#  The tesseract container runs a Flask HTTP API on port 5000.
#

# Internal URL (backend → tesseract inside Docker network)
OCR_SERVICE_URL=http://tesseract:5000/ocr

# How long to wait for OCR response (seconds)
OCR_TIMEOUT_SECONDS=30

# Minimum confidence score to accept a plate reading (0.0 - 1.0)
# 0.6 = 60% confidence required
OCR_MIN_CONFIDENCE=0.6

# Languages to try (comma-separated Tesseract lang codes)
# eng = English, ara = Arabic
OCR_LANGUAGES=eng,ara


##############################################################################
##  9. AUTHENTICATION & SECURITY
##############################################################################

# Sanctum token expiry (hours). 0 = never expire
# Affects: API tokens for mobile/scanner clients
GARAGE_TOKEN_EXPIRY_HOURS=24

# Session-based auth cookie name (should match SESSION_COOKIE above)
# Only needed if you have a custom cookie domain
SESSION_DOMAIN=.techaura-projects.com

# CORS — origins allowed to make API requests (comma-separated)
# In production: just your app domain. Dev: localhost:5173
CORS_ALLOWED_ORIGINS=https://techaura-projects.com,http://localhost:5173

# Password reset link expires after this many minutes
AUTH_PASSWORD_RESET_EXPIRE=60

# Maximum failed login attempts before lockout
AUTH_THROTTLE_MAX_ATTEMPTS=5

# Lockout duration in minutes after too many failed logins
AUTH_THROTTLE_DECAY_MINUTES=15


##############################################################################
##  10. GARAGE APP SETTINGS
##############################################################################

# Default SLA time for job cards (hours before a job is considered delayed)
# Can be overridden per job card
GARAGE_SLA_DEFAULT_HOURS=4

# Maximum file upload size (MB) for QC photos, documents
GARAGE_MAX_UPLOAD_MB=10

# How long a scan session pairing code stays valid (minutes)
GARAGE_SCAN_EXPIRY_MINUTES=30

# Company name shown in reports and PDF exports
GARAGE_COMPANY_NAME="TechAura Projects"

# Company logo URL for PDF reports (must be publicly accessible)
GARAGE_COMPANY_LOGO_URL=https://techaura-projects.com/logo.png

# Company address for PDF purchase orders
GARAGE_COMPANY_ADDRESS="P.O. Box 12345, Dubai, UAE"

# Company phone for PDF purchase orders
GARAGE_COMPANY_PHONE="+971 4 000 0000"

# Currency for purchase orders (ISO 4217 code)
# AED | USD | SAR | KWD | QAR | BHD | OMR
GARAGE_DEFAULT_CURRENCY=AED

# Number of bays in the garage (used by Bay Monitor)
GARAGE_BAY_COUNT=10

# Enable QR/plate scanning feature
GARAGE_SCAN_ENABLED=true

# Bearer token for Prometheus metrics scraping endpoint (/metrics)
# Generate with: openssl rand -hex 24
GARAGE_METRICS_BEARER_TOKEN=change_me_metrics_token


##############################################################################
##  11. LOGGING & MONITORING
##############################################################################

# Log channel: stack | single | daily | stderr | syslog
LOG_CHANNEL=stack
LOG_STACK=daily

# Log level: debug | info | notice | warning | error | critical | emergency
# Use "info" or "warning" in production — "debug" is very verbose
LOG_LEVEL=warning

# Log deprecation warnings (set to null in production to suppress noise)
LOG_DEPRECATIONS_CHANNEL=null

# Laravel Telescope (debug assistant — disable in production)
TELESCOPE_ENABLED=false

# Laravel Horizon dashboard access
# Set to true only when you need to inspect queues
HORIZON_ENABLED=true


##############################################################################
##  12. DOCKER & INFRASTRUCTURE PASSWORDS
##############################################################################
#
#  These are used by docker-compose.yml to configure containers.
#  Change ALL of these before deploying to production.
#

# MariaDB (duplicated here for docker-compose — must match section 3)
# DB_PASSWORD and DB_ROOT_PASSWORD already set in section 3 above

# Redis password (must also update docker/redis/redis.conf → requirepass)
REDIS_AUTH_PASSWORD=change_me_redis_password

# MinIO (must match section 7)
# MINIO_ROOT_USER and MINIO_ROOT_PASSWORD already set in section 7 above


##############################################################################
##  13. THIRD-PARTY INTEGRATIONS (optional — leave blank to disable)
##############################################################################

# ─── Slack Notifications ─────────────────────────────────────────────────────
# Get webhook URL from: https://api.slack.com/messaging/webhooks
# Send critical alerts and daily summaries to a Slack channel
LOG_SLACK_WEBHOOK_URL=
NOTIFY_SLACK_CHANNEL=#garage-alerts

# ─── WhatsApp / Twilio (optional) ────────────────────────────────────────────
# For sending SMS/WhatsApp alerts to mechanics or supervisors
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ─── Mailgun (alternative to SMTP) ───────────────────────────────────────────
# MAIL_MAILER=mailgun
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# ─── AWS SES (alternative to MinIO for storage) ──────────────────────────────
# Only if you want to use real AWS instead of self-hosted MinIO
# SES_KEY=
# SES_SECRET=
# SES_REGION=us-east-1

# ─── Sentry Error Tracking (optional) ────────────────────────────────────────
# Captures exceptions and sends them to Sentry dashboard
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
